{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LazyTerm",
  "version": "26.41.5759",
  "identifier": "com.lazy.term",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LazyTerm",
        "width": 1280,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost http://asset.localhost data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://asset.localhost http://172.50.0.243",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/LazyTerm-32.png",
      "icons/LazyTerm-128.png",
      "icons/LazyTerm-256.png",
      "icons/LazyTerm.icns",
      "icons/LazyTerm.ico"
    ]
  }
}