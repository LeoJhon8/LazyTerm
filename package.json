{
  "name": "lazy-terminal",
  "version": "1.0.0",
  "description": "A simple desktop terminal application",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node build-script.js",
    "build:watch": "tsc -b tsconfig.app.json --watch",
    "build:main": "tsc -b tsconfig.main.json",
    "build:renderer": "tsc -b tsconfig.renderer.json",
    "start": "npm run build && electron .",
    "dev": "concurrently \"npm run build:watch\" \"electron . --dev\"",
    "dev:main": "tsc -b tsconfig.main.json --watch",
    "dev:renderer": "tsc -b tsconfig.renderer.json --watch",
    "lint": "eslint src/**/*.{js,ts}",
    "lint:fix": "eslint src/**/*.{js,ts} --fix",
    "format": "prettier --write src/**/*.{js,ts}",
    "format:check": "prettier --check src/**/*.{js,ts}",
    "type-check": "tsc --noEmit",
    "type-check:main": "tsc -p tsconfig.main.json --noEmit",
    "type-check:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "clean": "rimraf dist"
  },
  "keywords": [
    "terminal",
    "electron",
    "desktop"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/electron": "^1.4.38",
    "@types/node": "^25.2.3",
    "@types/ssh2": "^1.15.5",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "concurrently": "^9.2.1",
    "electron": "^30.0.0",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0"
  }
}
